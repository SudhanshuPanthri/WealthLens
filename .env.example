# Copy this file to `.env` and fill in what you need.
# Everything except DATABASE_URL and AUTH_SECRET is optional —
# AI insights work with no keys at all (rule-based engine).

# --- Required ---------------------------------------------------------------

# Database. SQLite for dev; Postgres for production.
# Postgres: set provider = "postgresql" in prisma/schema.prisma and use e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/wealthlens?sslmode=require"
DATABASE_URL="file:./dev.db"

# Signs auth session tokens — use any long random string.
AUTH_SECRET="change-me-to-a-long-random-string"

# Base URL of the app — used to build OAuth redirect URIs.
APP_URL="http://localhost:3000"

# --- AI insights provider ladder (all optional) -----------------------------
# Priority when present: Claude > OpenRouter > Gemini > rule-based (no key).
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
GEMINI_API_KEY=""

# --- Google sign-in (optional) ----------------------------------------------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <APP_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Background quote refresh (optional) ------------------------------------
# In-process timer warms the quote cache during market hours.
# Set BACKGROUND_REFRESH=off on serverless and use /api/cron/refresh instead.
BACKGROUND_REFRESH=""
QUOTE_REFRESH_MS=""
# Shared secret to authorize GET /api/cron/refresh (required in production).
CRON_SECRET=""

# --- Production tuning (optional) -------------------------------------------
# Max concurrent LLM insight generations (default 2).
LLM_CONCURRENCY=""
# Max insight generations per user per minute (default 8).
INSIGHTS_RATE_LIMIT=""
