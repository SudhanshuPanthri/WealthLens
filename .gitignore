# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ignore real envs, but DO ship the example template.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database — local SQLite holds real user data; never commit it.
# (Commit prisma/schema.prisma and migrations, NOT the .db files.)
*.db
*.db-journal
*.db-wal
*.db-shm
/prisma/*.db
/prisma/dev.db

# local test / runtime artifacts
.smoke_cookies
*.cookies
cj*.txt
/coverage

# editor / OS
.idea/
.vscode/
*.swp
Thumbs.db
