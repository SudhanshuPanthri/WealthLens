generator client {
  provider = "prisma-client-js"
  // "native" for local dev; the rhel target is what Vercel's serverless runtime
  // needs (without it, deploys fail with "could not locate the Query Engine").
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// Postgres (Neon) for both local dev and production. On Neon/Vercel use the
// POOLED connection string for `url` (serverless runtime) and the DIRECT one for
// `directUrl` (migrations) — see DEPLOY.md.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  // null for accounts created purely via an OAuth provider (no password set)
  passwordHash String?
  avatarUrl    String?
  createdAt    DateTime       @default(now())
  sessions     Session[]
  portfolios   Portfolio[]
  oauthAccounts OAuthAccount[]
}

// Links a User to an external identity provider (Google, etc.). A user may
// have several — one per provider — all resolving to the same account.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | ...
  providerAccountId String // the provider's stable user id (sub)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Portfolio {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String        @default("My Portfolio")
  createdAt DateTime      @default(now())
  holdings     Holding[]
  imports      ImportBatch[]
  insights     Insight[]
  watchlist    WatchlistItem[]
  transactions Transaction[]
  fundHoldings FundHolding[]

  @@index([userId])
}

// A stock the user is tracking but doesn't (necessarily) own. Keyed unique on
// (portfolioId, symbol, exchange) so the same ticker can't be added twice.
model WatchlistItem {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol      String // NSE/BSE trading symbol, e.g. RELIANCE
  exchange    String    @default("NSE") // NSE | BSE
  name        String?
  createdAt   DateTime  @default(now())

  @@unique([portfolioId, symbol, exchange])
  @@index([portfolioId])
}

model ImportBatch {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  broker      String // ZERODHA | GROWW | GENERIC | CAMS | KFINTECH | CSV
  fileName    String
  rowCount    Int
  kind        String        @default("HOLDINGS") // HOLDINGS | TRANSACTIONS | FUNDS
  createdAt   DateTime      @default(now())
  holdings    Holding[]
  transactions Transaction[]
  fundHoldings FundHolding[]

  @@index([portfolioId])
}

// One mutual-fund position, identified by scheme + folio. Brought in via a
// mutual-fund CSV/Excel or a CAMS/KFintech Consolidated Account Statement (CAS).
// Valued live against mfapi.in NAV — the first non-stock asset class in the app.
model FundHolding {
  id            String       @id @default(cuid())
  portfolioId   String
  portfolio     Portfolio    @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  schemeName    String
  schemeCode    String? // mfapi.in scheme code, resolved once and cached in FundSchemeMap
  isin          String?
  amc           String? // fund house, e.g. "Parag Parikh"
  folio         String?
  units         Float
  avgNav        Float // cost basis per unit (cost value / units)
  costValue     Float? // total invested, when the source provides it directly
  source        String       @default("CSV") // CAMS | KFINTECH | CSV
  // (portfolioId, dedupeKey) is the upsert key. dedupeKey = isin|folio when an
  // ISIN is known, else a normalized scheme name + folio — so a re-imported CAS
  // updates positions instead of duplicating them.
  dedupeKey     String
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([portfolioId, dedupeKey])
  @@index([portfolioId])
}

// ISIN/name -> mfapi.in scheme resolution, cached permanently (like SymbolMap
// for stocks). Mutual-fund statements identify schemes by name/ISIN, not by the
// numeric scheme code mfapi.in needs for NAV lookups.
model FundSchemeMap {
  key        String   @id // "isin:INF..." (preferred) or "name:<normalized>"
  schemeCode String
  schemeName String
  isin       String?
  category   String?
  updatedAt  DateTime @updatedAt
}

// A single executed trade (buy or sell). The transaction ledger powers realized
// P&L (FIFO), XIRR, and the invested-over-time chart — separate from the
// current-holdings view, which can be imported independently.
model Transaction {
  id            String       @id @default(cuid())
  portfolioId   String
  portfolio     Portfolio    @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol        String // NSE/BSE trading symbol
  exchange      String       @default("NSE")
  isin          String?
  name          String?
  type          String // BUY | SELL
  quantity      Float
  price         Float // per-share INR
  fees          Float        @default(0) // brokerage + taxes, if known
  tradedAt      DateTime
  broker        String
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([portfolioId, tradedAt])
}

model Holding {
  id            String       @id @default(cuid())
  portfolioId   String
  portfolio     Portfolio    @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol        String // NSE/BSE trading symbol, e.g. RELIANCE
  exchange      String       @default("NSE") // NSE | BSE
  isin          String?
  name          String?
  quantity      Float
  avgPrice      Float // average buy price per share (INR)
  broker        String // ZERODHA | GROWW | GENERIC
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // The same stock held at two brokers stays as two rows (broker-tagged);
  // re-importing from the same broker upserts instead of duplicating.
  @@unique([portfolioId, symbol, broker])
  @@index([portfolioId])
}

model QuoteCache {
  symbol     String   @id // yahoo symbol, e.g. RELIANCE.NS
  price      Float
  prevClose  Float?
  dayChange  Float? // percent
  name       String?
  sector     String?
  industry   String?
  marketCap  Float?
  high52     Float?
  low52      Float?
  trailingPE Float?
  updatedAt  DateTime @updatedAt
}

// Groww exports identify stocks by ISIN + name only; this caches the
// resolved NSE/BSE trading symbol so we resolve each ISIN once.
model SymbolMap {
  isin      String   @id
  symbol    String
  exchange  String   @default("NSE")
  name      String?
  updatedAt DateTime @updatedAt
}

model Insight {
  id           String    @id @default(cuid())
  portfolioId  String
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  snapshotHash String // hash of holdings+quotes the insight was generated from
  model        String
  engine       String    @default("rule-based") // rule-based | gemini | claude
  content      String // JSON payload of the structured insight
  createdAt    DateTime  @default(now())

  @@index([portfolioId, createdAt])
}
